DATABASE_URL="file:./dev.db"
APP_ENCRYPTION_KEY="replace-with-a-long-random-local-secret"

# Gmail OAuth. Redirect URI for local dev:
# http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
GMAIL_SYNC_MONTHS=48
GMAIL_SYNC_LIMIT=500

# Kite MCP server. Docker Compose uses http://kite-mcp:8080/mcp.
KITE_MCP_URL="http://localhost:8080/mcp"

# Vercel AI Gateway. If unset, chat returns a deterministic local summary.
AI_MODEL="openai/gpt-5.4"
AI_GATEWAY_API_KEY=""
