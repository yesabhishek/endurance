# Local development settings. `../scripts/setup.sh` writes a real web/.env for you.
# Start the databases first:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis

DATABASE_URL=postgresql://endurance:<POSTGRES_PASSWORD>@localhost:5432/endurance
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
APP_SECRET=
APP_URL=http://localhost:3000

# Optional Gmail spending data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
