# Endurance configuration
# -----------------------
# Copy this file to .env, fill in the two Kite values and one AI key, then run
# `npm run dev` (or `docker compose up`) and open http://localhost:3000.
# .env is ignored by git. Never commit it.

# --- Zerodha Kite Connect (required) -------------------------------------------
# Create an app at https://developers.kite.trade/apps (the free Personal plan works)
# and set its Redirect URL to APP_URL + /api/kite/callback, e.g.
#   http://localhost:3000/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# --- AI provider (set one key) -------------------------------------------------
# Endurance uses the first key it finds, in this order. Set AI_PROVIDER to choose
# when you have several (openai | anthropic | google | gateway).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
AI_PROVIDER=

# Model to use. Defaults: gpt-5.5 (OpenAI), claude-sonnet-5-5 (Anthropic).
# Required for Google and the AI Gateway (e.g. anthropic/claude-sonnet-5-5).
AI_MODEL=

# Any OpenAI-compatible server instead of OpenAI itself: OpenRouter, Groq,
# Ollama (http://localhost:11434/v1), LM Studio... Set AI_MODEL too.
OPENAI_BASE_URL=

# --- Optional ------------------------------------------------------------------
# Where you open Endurance. Change it if you use another port or host name.
APP_URL=http://localhost:3000

# Your concentration limits, in percent. Risk checks and answers flag anything above them.
LIMIT_STOCK_PCT=10
LIMIT_SECTOR_PCT=25

# Folder for today's Kite session, daily snapshots and chats (default: .data).
DATA_DIR=

# Extra host names allowed to reach the app, comma separated (only when you put
# Endurance behind your own reverse proxy).
ALLOWED_HOSTS=
