# Endurance Environment Configuration
# ------------------------------------
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# Required: Kite Connect API credentials
# Register at https://developers.kite.trade/signup
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Required: local token encryption key for the Next.js app
APP_ENCRYPTION_KEY=replace-with-a-long-random-local-secret

# Optional: Gmail OAuth for read-only financial email ingestion
# Redirect URI for local Docker: http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_SYNC_MONTHS=48
GMAIL_SYNC_LIMIT=500

# Optional: Vercel AI Gateway for finance chat
AI_MODEL=openai/gpt-5.4
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Optional: Finnhub API key for stock news
# Get one at https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-api-key
