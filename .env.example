# Endurance configuration
# -----------------------
# Run ./scripts/setup.sh to create .env from this file with fresh random secrets.
# Never commit .env. Kite and AI provider keys are NOT set here: each user adds
# their own in the app (Settings), where they are encrypted at rest.

# Master secret for encryption and sessions. 32+ random characters.
APP_SECRET=

# Set this when rotating APP_SECRET: move the old value here so stored keys still decrypt.
APP_SECRET_PREVIOUS=

# Where you open Endurance in the browser. Kite's redirect URL is APP_URL + /api/kite/callback.
APP_URL=http://localhost:3000

# Extra host names allowed to reach the app (comma separated), for example when
# serving it behind a reverse proxy under your own domain.
ALLOWED_HOSTS=

# Database and queue passwords used by docker compose.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Let more people create accounts on this install after the owner (household or team use).
ALLOW_SIGNUP=false

# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional: Gmail (read-only) for spending data. Create an OAuth "Web application"
# client and add APP_URL + /api/gmail/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SYNC_MONTHS=48
GMAIL_SYNC_LIMIT=500
