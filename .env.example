# Endurance Environment Configuration
# ------------------------------------
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# Required: Kite Connect API credentials
# Register at https://developers.kite.trade/signup
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Optional: Django secret key (auto-generated if not set)
DJANGO_SECRET_KEY=your-secure-random-secret-key

# Optional: OpenAI API key for AI investment suggestions
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Finnhub API key for stock news
# Get one at https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-api-key
